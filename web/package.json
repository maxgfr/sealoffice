{
  "name": "sealoffice-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build:crypto": "cd .. && cargo build -p seal-crypto --target wasm32-unknown-unknown --release && wasm-bindgen target/wasm32-unknown-unknown/release/seal_crypto.wasm --out-dir web/src/pkg/seal --target web",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:e2e": "bun test/e2e/smoke.ts",
    "test:e2e:word": "bun test/e2e/word.ts",
    "test:e2e:live": "bun test/e2e/live.ts",
    "test:e2e:sw": "bun test/e2e/sw.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "1.63.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "trystero": "0.25.4"
  }
}
